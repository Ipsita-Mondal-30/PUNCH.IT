# ─── Shared ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# For Supabase pooler (port 6543), username must be postgres.[project-ref], not just postgres
DATABASE_URL=postgresql://postgres.[project-ref]:password@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/punchit?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Supabase Storage ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=deployments

# ─── Authentication (Better Auth + GitHub OAuth) ──────────────────────────────
BETTER_AUTH_SECRET=your-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Optional dedicated key for encrypting GitHub tokens at rest (falls back to BETTER_AUTH_SECRET)
TOKEN_ENCRYPTION_KEY=

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
API_HOST=0.0.0.0

# ─── Google Cloud (Worker deployment pipeline) ────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_ARTIFACT_REGISTRY=us-central1-docker.pkg.dev/your-project/punchit
GCP_CLOUD_RUN_SERVICE_PREFIX=punchit-app-
